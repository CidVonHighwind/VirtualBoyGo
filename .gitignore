# CMake build output (root project + PC target)
build-pc/
build-android/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_deps/

# Note: Platform/GeneratedShaders/ is intentionally NOT ignored - it holds
# SPIR-V headers produced by the PC build's shader compiler (glslang isn't
# built for Android cross-compiles, so that build just consumes whatever the
# PC build most recently generated there). Re-run a PC build after editing
# shaders/*.vert|frag to refresh them, then commit the updated headers.

